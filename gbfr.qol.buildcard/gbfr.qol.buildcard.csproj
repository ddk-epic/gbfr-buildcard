<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <OutputPath>$(RELOADEDIIMODS)/gbfr.qol.buildcard</OutputPath>
    <ImplicitUsings>enable</ImplicitUsings>

    <ReloadedILLink>false</ReloadedILLink>
  </PropertyGroup>

  <ItemGroup>
    <ReloadedLinkRoots Include="gbfr.qol.buildcard" />
  </ItemGroup>

  <Import Project="Reloaded.Trimming.targets" />
  <Import Project="Reloaded.Checks.targets" />

  <ItemGroup>
    <None Remove="ModConfig.json" />
    <None Remove="Publish.ps1" />
    <None Remove="BuildLinked.ps1" />
    <None Remove="Reloaded.Trimming.targets" />
    <None Remove="Reloaded.Checks.targets" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ModConfig.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Update="Preview.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Signatures\*.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Data\master_traits.tsv" LogicalName="master_traits.tsv" />
    <None Update="GBFR\**\*.msg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="gbfrelink.utility.manager.Interfaces" Version="1.2.0" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="9.0.3" />
    <PackageReference Include="NenTools.Reloaded.ScanManager.Interfaces" Version="1.0.0" />
    <PackageReference Include="Reloaded.Memory" Version="9.4.3" />
    <PackageReference Include="Reloaded.Memory.Sigscan" Version="3.1.8" />
    <PackageReference Include="Reloaded.Memory.SigScan.ReloadedII.Interfaces" Version="1.2.0" />
    <PackageReference Include="Reloaded.Mod.Interfaces" Version="2.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="Reloaded.SharedLib.Hooks" Version="1.9.0" />
  </ItemGroup>

  <!-- Converts the UI overrides in GBFR to the game's binary formats in the mod's GBFR folder. -->
  <PropertyGroup>
    <UiToolDir>$(MSBuildThisFileDirectory)..\tools\gbfr.uitools\</UiToolDir>
    <UiToolExe>$(UiToolDir)bin\Release\net10.0\gbfr.uitools.exe</UiToolExe>
  </PropertyGroup>

  <ItemGroup>
    <UiSource Include="GBFR\**\*.prfb.yaml" Binary="%(Filename)" />
    <UiSource Include="GBFR\**\*.list.yaml" Binary="%(Filename).listb" />
    <None Remove="@(UiSource)" />
  </ItemGroup>

  <Target Name="BuildUiTool" AfterTargets="Build" Condition="'@(UiSource)' != ''">
    <Exec Command="dotnet build -c Release -nologo -v q" WorkingDirectory="$(UiToolDir)" />
  </Target>

  <Target Name="ConvertUiSources" AfterTargets="BuildUiTool" Condition="'@(UiSource)' != ''"
          Inputs="@(UiSource);$(UiToolExe)"
          Outputs="@(UiSource->'$(OutDir)GBFR\%(RecursiveDir)%(Binary)')">
    <MakeDir Directories="@(UiSource->'$(OutDir)GBFR\%(RecursiveDir)')" />
    <Delete Files="$(OutDir)GBFR\%(UiSource.RecursiveDir)%(UiSource.Binary)" />
    <Exec Command="&quot;$(UiToolExe)&quot; b-convert -i &quot;%(UiSource.FullPath)&quot; -o &quot;$(OutDir)GBFR\%(UiSource.RecursiveDir)%(UiSource.Binary)&quot;" StandardOutputImportance="low" />
    <Error Condition="!Exists('$(OutDir)GBFR\%(UiSource.RecursiveDir)%(UiSource.Binary)')"
           Text="Converting %(UiSource.Identity) failed; run the tool on it for the error." />
  </Target>

</Project>
